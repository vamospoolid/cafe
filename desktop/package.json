{
  "name": "muki-ramen-pos",
  "version": "1.0.0",
  "description": "MUKI RAMEN POS Desktop - Aplikasi kasir dengan raw thermal printing",
  "main": "main.js",
  "author": "MUKI RAMEN",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.mukiramen.pos",
    "productName": "MUKI RAMEN POS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "MUKI RAMEN POS"
    },
    "files": [
      "main.js",
      "preload.js",
      "printer.js",
      "assets/**/*"
    ]
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1"
  }
}
