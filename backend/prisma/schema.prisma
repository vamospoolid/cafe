// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core SaaS Multi-Tenant Platform Entities ─────────────────────────────

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique // e.g. "mukiramen" -> mukiramen.codenusa.id
  customDomain String?  @unique // e.g. "pos.mukiramen.com"
  logoUrl      String?
  status       String   @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, GRACE_PERIOD, SUSPENDED, CANCELLED
  planId       String?  // References SaaS Plan
  plan         Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  trialEndsAt  DateTime?

  // Platform & Hierarchy Relations
  outlets             Outlet[]
  memberships         TenantMembership[]
  roles               Role[]
  paymentConfig       TenantPaymentConfig?
  sessions            UserSession[]
  featureOverrides    TenantFeature[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  paymentTransactions PaymentTransaction[]
  usageRecords        UsageRecord[]

  // Business Domain Relations
  categories           Category[]
  products             Product[]
  tables               Table[]
  reservations         Reservation[]
  customers            Customer[]
  pointLogs            PointLog[]
  orders               Order[]
  cashFlows            CashFlow[]
  attendances          Attendance[]
  settings             Settings[]
  shifts               Shift[]
  suppliers            Supplier[]
  ingredients          Ingredient[]
  ingredientLogs       IngredientLog[]
  purchaseOrders       PurchaseOrder[]
  debts                Debt[]
  debtPayments         DebtPayment[]
  leaveRequests        LeaveRequest[]
  shiftHandovers       ShiftHandover[]
  kitchenChecklists    KitchenChecklist[]
  warehouseInbounds    WarehouseInbound[]
  warehouseRequisitions WarehouseRequisition[]
  ownerFundTransactions OwnerFundTransaction[]
  warehouseSales       WarehouseSale[]
  employeeLoans        EmployeeLoan[]
  auditLogs            AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([slug])
}

model Outlet {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  code            String   // e.g. "MUK-01", unique within tenant
  address         String?
  phone           String?
  latitude        Float?
  longitude       Float?
  gpsRadiusMeters Float    @default(100)
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE, CLOSED
  settings        String?  // JSON stringified outlet specific config

  // Relations scoped to Outlet
  tables               Table[]
  reservations         Reservation[]
  orders               Order[]
  cashFlows            CashFlow[]
  attendances          Attendance[]
  shifts               Shift[]
  shiftHandovers       ShiftHandover[]
  kitchenChecklists    KitchenChecklist[]
  warehouseRequisitions WarehouseRequisition[]
  ingredientLogs       IngredientLog[]
  purchaseOrders       PurchaseOrder[]
  settingsRel          Settings[]
  auditLogs            AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  pin          String   @default("123456")
  role         String   // Legacy role (Admin, Kasir, Dapur, Waiter)
  employmentType String @default("FULL_TIME") // FULL_TIME, DAILY_WORKER, PART_TIME
  permissions  String   // Legacy JSON stringified permissions
  status       String   @default("Aktif")
  isPlatformAdmin Boolean @default(false)

  // Multi-Tenant Relations
  memberships      TenantMembership[]
  sessions         UserSession[]

  // Legacy & Scoped Business Relations
  orders            Order[]
  cashFlows         CashFlow[]
  attendances       Attendance[]
  shifts            Shift[]
  purchaseOrders    PurchaseOrder[]
  debtPayments      DebtPayment[]
  ingredientLogs    IngredientLog[]
  leaveRequests     LeaveRequest[]
  shiftHandovers    ShiftHandover[]
  kitchenChecklists KitchenChecklist[]
  warehouseInbounds WarehouseInbound[]
  warehouseSales    WarehouseSale[]        @relation("WarehouseSaleSoldBy")
  reqsRequested     WarehouseRequisition[] @relation("ReqRequestedBy")
  reqsApproved      WarehouseRequisition[] @relation("ReqApprovedBy")
  ownerFundTxns     OwnerFundTransaction[]
  employeeLoans     EmployeeLoan[]
  auditLogs         AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantMembership {
  id             String   @id @default(uuid())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  pin            String?  // 4-8 digit quick switch PIN within this tenant
  employmentType String   @default("FULL_TIME") // FULL_TIME, DAILY_WORKER, PART_TIME
  status         String   @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED, TERMINATED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  // Null for system-wide default roles, non-null for custom tenant roles
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // OWNER, ADMIN, MANAGER, SUPERVISOR, CASHIER, KITCHEN, WAREHOUSE, HR
  description String?
  isSystem    Boolean  @default(false)

  permissions RolePermission[]
  memberships TenantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "pos.create", "inventory.adjust", "reports.view"
  name        String
  module      String   // POS, INVENTORY, WAREHOUSE, HR, FINANCE, SETTINGS, PLATFORM
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

model TenantPaymentConfig {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isMidtransEnabled Boolean  @default(false)
  midtransMode      String   @default("SANDBOX") // SANDBOX, PRODUCTION
  serverKey         String?  // Encrypted AES-256
  clientKey         String?
  merchantId        String?
  enableQRIS        Boolean  @default(true)
  enableVA          Boolean  @default(false)
  enableGoPay       Boolean  @default(true)
  enableShopeePay   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── SaaS Plans, Features & Entitlements ───────────────────────────────────

model Plan {
  id           String        @id @default(uuid())
  code         String        @unique // STARTER, GROWTH, BUSINESS, ENTERPRISE
  name         String
  description  String?
  priceMonthly Float         @default(0)
  priceYearly  Float         @default(0)
  maxOutlets   Int           @default(1)
  maxUsers     Int           @default(3)
  maxProducts  Int           @default(100)
  isActive     Boolean       @default(true)
  
  features      PlanFeature[]
  tenants       Tenant[]
  subscriptions Subscription[]
  invoices      Invoice[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Feature {
  id              String          @id @default(uuid())
  key             String          @unique // e.g. "pos", "kds", "inventory", "warehouse", "crm", "attendance", "payroll", "loans", "multi_outlet", "table_management"
  name            String
  module          String          // POS, OPERATIONS, WAREHOUSE, HR, FINANCE, ADVANCED
  description     String?
  isCore          Boolean         @default(false) // Core feature is always active on all plans
  status          String          @default("ACTIVE") // ACTIVE, BETA, DEPRECATED

  plans           PlanFeature[]
  tenantOverrides TenantFeature[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([module])
}

model PlanFeature {
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  limitValue Int?     // Optional quota override (e.g., max 500 orders/month)

  createdAt  DateTime @default(now())

  @@id([planId, featureId])
  @@index([planId])
  @@index([featureId])
}

model TenantFeature {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature   @relation(fields: [featureId], references: [id], onDelete: Cascade)
  isEnabled  Boolean   @default(true) // true = Grant/Add-on, false = Revoke/Block
  expiresAt  DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@index([featureId])
}

// ─── Subscriptions, Invoices & Payment Transactions ────────────────────────

model Subscription {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, CANCELLED, EXPIRED
  billingCycle       String    @default("MONTHLY") // MONTHLY, YEARLY
  amount             Float
  startDate          DateTime  @default(now())
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)

  invoices           Invoice[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

model Invoice {
  id              String               @id @default(uuid())
  invoiceNumber   String               @unique // e.g. "INV-202609-0001"
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId          String?
  plan            Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount          Float
  taxAmount       Float                @default(0)
  totalAmount     Float
  status          String               @default("UNPAID") // UNPAID, PAID, VOID, REFUNDED
  dueDate         DateTime
  paidAt          DateTime?
  paymentMethod   String?              // MIDTRANS_SNAP, MIDTRANS_QRIS, MIDTRANS_VA, MANUAL_TRANSFER
  paymentProofUrl String?

  transactions    PaymentTransaction[]

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([tenantId])
  @@index([status])
}

model PaymentTransaction {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId         Int?      // Optional for Level 2 POS Order payment
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  gateway         String    @default("MIDTRANS") // MIDTRANS, MANUAL
  gatewayOrderId  String    @unique // e.g. "SAAS-INV-202609-0001" or "POS-ORD-12345"
  transactionId   String?   // Gateway reference ID
  paymentType     String?   // qris, bank_transfer, gopay, shopeepay, credit_card
  amount          Float
  status          String    @default("PENDING") // PENDING, SUCCESS, FAILED, EXPIRED, CANCELLED
  snapToken       String?
  snapRedirectUrl String?
  rawResponse     String?   // JSON stringified payload from gateway
  paidAt          DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([gatewayOrderId])
}

model UsageRecord {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric       String   // OUTLETS, USERS, PRODUCTS, ORDERS_MONTHLY, STORAGE_MB
  period       String   @default("LIFETIME") // e.g. "2026-09" or "LIFETIME"
  currentValue Int      @default(0)
  limitValue   Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, metric, period])
  @@index([tenantId])
  @@index([metric])
}

// ─── Immutable Audit Logging & Activity Trail ──────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?  // Snapshot of user name at time of action
  userRole    String?  // Snapshot of user role at time of action
  action      String   // e.g. LOGIN, LOGOUT, VOID_ORDER, REFUND_ORDER, PRICE_CHANGE, STOCK_ADJUST, USER_CREATE, SETTINGS_UPDATE
  resource    String   // e.g. AUTH, ORDER, PRODUCT, INVENTORY, USER, SETTINGS, BILLING, FINANCE
  resourceId  String?  // ID or reference of the impacted record
  description String?  // Human readable message
  oldValue    String?  // JSON stringified state before modification
  newValue    String?  // JSON stringified state after modification
  ipAddress   String?
  userAgent   String?
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([outletId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([severity])
  @@index([createdAt])
}

// ─── Business Models (Refactored with Tenant & Outlet Scoping) ─────────────

model Category {
  id            Int        @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  printerTarget String     @default("KITCHEN") // KITCHEN, BAR, NONE
  parentId      Int?
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subCategories Category[] @relation("CategoryHierarchy")

  products    Product[] @relation("ProductCategory")
  subProducts Product[] @relation("ProductSubCategory")

  @@index([tenantId])
}

model Product {
  id            Int       @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barcode       String?
  name          String
  category      Category  @relation("ProductCategory", fields: [categoryId], references: [id])
  categoryId    Int
  subCategory   Category? @relation("ProductSubCategory", fields: [subCategoryId], references: [id])
  subCategoryId Int?
  buyPrice      Float     @default(0)
  sellPrice     Float
  stock         Int       @default(0)
  minStock      Int       @default(1)
  imageUrl      String?
  status        String    @default("Aktif")

  orderItems OrderItem[]
  recipes    RecipeItem[] // Komposisi bahan baku (Advanced Mode)
  poItems    PurchaseOrderItem[] // Referensi PO (Simple Mode)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, status])
}

model Table {
  id       Int     @id @default(autoincrement())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId String?
  outlet   Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tableNo  String
  name     String? // Keterangan Lokasi
  capacity Int     @default(2)
  status   String  @default("Aktif") // Aktif, Perbaikan
  qrUrl    String?

  posX  Float? @default(10) // Posisi X dalam persentase canvas (0-100)
  posY  Float? @default(10) // Posisi Y dalam persentase canvas (0-100)
  shape String @default("square") // Bentuk: 'square' atau 'circle'

  orders       Order[]
  reservations Reservation[]

  @@unique([outletId, tableNo])
  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, status])
}

model Reservation {
  id           Int     @id @default(autoincrement())
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId     String?
  outlet       Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customerName String
  phone        String
  date         String // YYYY-MM-DD
  time         String // HH:mm
  table        Table   @relation(fields: [tableId], references: [id])
  tableId      Int
  guests       Int
  dpAmount     Float   @default(0)
  status       String  @default("Booking") // Booking, DP Dibayar, Lunas
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, date])
}

model Customer {
  id         Int      @id @default(autoincrement())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  email      String?
  birthday   String?
  points     Int      @default(0)
  tier       String   @default("Bronze") // Bronze, Silver, Gold
  totalSpent Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders    Order[]
  pointLogs PointLog[]
  debts     Debt[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, totalSpent])
}

model PointLog {
  id          Int      @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId  Int
  points      Int // Positif untuk Earn/Refund, Negatif untuk Redeem/Void
  type        String // 'Earn', 'Redeem', 'Refund', 'Manual'
  description String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
}

model Order {
  id            Int     @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId      String?
  outlet        Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderNumber   String
  offlineId     String?
  customerName  String
  customerPhone String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId Int?

  table          Table?   @relation(fields: [tableId], references: [id])
  tableId        Int?
  joinedTableIds String? // JSON stringified array of table IDs [2, 3]

  user   User @relation(fields: [userId], references: [id])
  userId Int

  subtotal      Float
  discount      Float     @default(0)
  tax           Float
  serviceCharge Float
  total         Float
  paymentMethod String?
  status        String    @default("Pending") // Pending, Paid, Void
  kdsStatus     String    @default("Pending") // Pending, Cooking, Ready, Served
  servedAt      DateTime?
  paidAt        DateTime? // Waktu transaksi pembayaran diselesaikan

  items OrderItem[]
  debt  Debt?
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, offlineId])
  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, outletId])
  @@index([userId])
  @@index([tableId])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  tenantId  String?
  outletId  String?
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  qty       Int
  price     Float
  buyPrice  Float   @default(0)
  subtotal  Float
  notes     String?

  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
}

model CashFlow {
  id          Int      @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  type        String // Pemasukan, Pengeluaran
  category    String
  amount      Float
  description String
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  date        DateTime @default(now())

  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, date])
  @@index([tenantId, type])
  @@index([userId])
}

model Attendance {
  id             Int       @id @default(autoincrement())
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId       String?
  outlet         Outlet?   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  clockIn        DateTime  @default(now())
  clockOut       DateTime?
  date           String // YYYY-MM-DD
  shiftName      String? // e.g. "Shift Pagi (08:00 - 16:00)"
  photoIn        String? // Data URL / Base64 foto selfie saat masuk
  photoOut       String? // Data URL / Base64 foto selfie saat pulang
  latitudeIn     Float?
  longitudeIn    Float?
  latitudeOut    Float?
  longitudeOut   Float?
  distanceIn     Float? // Jarak dalam meter dari toko saat clock in
  isWithinRadius Boolean   @default(true)
  status         String    @default("Hadir") // Hadir, Terlambat, Di Luar Radius
  lateMinutes    Int       @default(0) // Jumlah menit keterlambatan
  notes          String?

  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, date])
  @@index([tenantId, userId, date])
}

model Settings {
  id                       Int     @id @default(autoincrement())
  tenantId                 String?
  tenant                   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId                 String?
  outlet                   Outlet? @relation(fields: [outletId], references: [id], onDelete: Cascade)
  storeName                String  @default("DEMO CAFE")
  phone                    String  @default("")
  address                  String  @default("")
  logoUrl                  String  @default("")
  receiptHeader            String  @default("")
  receiptFooter            String  @default("")
  taxRate                  Float   @default(0)
  serviceCharge            Float   @default(0)
  includeTax               Boolean @default(false)
  bankName                 String  @default("")
  accountNumber            String  @default("")
  accountName              String  @default("")
  qrisUrl                  String  @default("")
  qrCodeBaseUrl            String  @default("")
  enableDrinkCustomization Boolean @default(false)

  loyaltyEnabled          Boolean @default(true)
  loyaltyEarnPerAmount    Float   @default(10000)
  loyaltyPointValue       Float   @default(100)
  loyaltySilverThreshold  Float   @default(1000000)
  loyaltyGoldThreshold    Float   @default(3000000)
  loyaltySilverMultiplier Float   @default(1.2)
  loyaltyGoldMultiplier   Float   @default(1.5)

  // Mode Inventaris: false = Simple (HPP manual), true = Advanced (HPP dari resep bahan baku)
  ingredientTrackingEnabled Boolean @default(false)

  // Kontrol Dapur & Audit Opsional
  enableKitchenAuditMode    Boolean @default(false)
  enableStaffMealTracking   Boolean @default(true)

  // Konfigurasi Printer Kasir 80mm
  printerIp          String  @default("")
  printerPort        Int     @default(9100)
  windowsPrinterName String  @default("")
  autoPrintKDS       Boolean @default(false)
  autoPrintReceipt   Boolean @default(false)

  // Konfigurasi Printer Dapur & Bar
  kitchenPrinterIp   String  @default("")
  kitchenPrinterPort Int     @default(9100)
  autoPrintKitchen   Boolean @default(false)
  barPrinterIp       String  @default("")
  barPrinterPort     Int     @default(9100)
  autoPrintBar       Boolean @default(false)

  // Konfigurasi Layar Dapur (KDS)
  enableKDS            Boolean @default(true)
  autoCompleteKDSOnPay Boolean @default(true)

  // Konfigurasi Absensi & GPS Geofencing Toko
  storeLatitude       Float   @default(-6.200000)
  storeLongitude      Float   @default(106.816666)
  gpsRadiusMeters     Float   @default(100)
  enableGpsValidation Boolean @default(true)
  enableCameraPhoto   Boolean @default(true)
  workShifts          String? // JSON list shift kerja

  // Reward & Punishment Karyawan
  enableZeroLateBonus    Boolean @default(true)
  zeroLateBonusAmount    Float   @default(200000)
  zeroLateMinAttendance  Int     @default(20)
  zeroLateMaxLateAllowed Int     @default(0)
  enableLatePenalty      Boolean @default(false)
  latePenaltyType        String  @default("FLAT")
  latePenaltyAmount      Float   @default(10000)
  enableAlphaPenalty     Boolean @default(false)
  alphaPenaltyAmount     Float   @default(50000)

  // Gudang Pusat & Transfer Pricing
  warehouseTransferPricing String @default("AT_COST")
  warehouseMarkupPercent   Float  @default(0)

  // Bagi Hasil (Profit Sharing)
  profitSharingOwnerPercent Float  @default(80)
  profitSharingRamenPercent Float  @default(20)
  profitSharingDrinkPercent Float  @default(20)
  profitSharingOpexMode     String @default("BEFORE_SPLIT")

  // Bonus Harian Omzet Karyawan Full Time
  enableDailyOmzetBonus Boolean @default(true)
  dailyOmzetTiers       String?

  @@index([tenantId])
  @@index([outletId])
}

model Shift {
  id              Int       @id @default(autoincrement())
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId        String?
  outlet          Outlet?   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  waktuBuka       DateTime  @default(now())
  waktuTutup      DateTime?
  saldoAwal       Float
  saldoSistem     Float?
  saldoElektronik Float?
  saldoFisikLaci  Float?
  selisih         Float?
  status          String    @default("Open") // Open, Closed

  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, status])
  @@index([tenantId, waktuBuka])
  @@index([userId])
}

// ─── Inventaris & Pembelian ────────────────────────────────────────────

model Supplier {
  id       Int     @id @default(autoincrement())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  contact  String?
  phone    String?
  email    String?
  address  String?
  notes    String?

  ingredients       Ingredient[]
  purchaseOrders    PurchaseOrder[]
  warehouseInbounds WarehouseInbound[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Ingredient {
  id          Int       @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  category    String    @default("FOOD") // FOOD, DRINK, PACKAGING
  subCategory String?
  unit        String // gram, ml, buah, liter, kg
  stock       Float     @default(0)
  minStock    Float     @default(0)
  buyPrice    Float     @default(0)
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  supplierId  Int?

  // Konversi Satuan Grosir & Gudang Pusat
  purchaseUnit      String?
  conversionRatio   Float   @default(1)
  warehouseStock    Float   @default(0)
  warehouseMinStock Float   @default(0)

  recipes                   RecipeItem[]
  stockLogs                 IngredientLog[]
  poItems                   PurchaseOrderItem[]
  warehouseInboundItems     WarehouseInboundItem[]
  warehouseRequisitionItems WarehouseRequisitionItem[]
  warehouseSaleItems        WarehouseSaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
  @@index([supplierId])
}

model RecipeItem {
  id            Int        @id @default(autoincrement())
  tenantId      String?
  product       Product    @relation(fields: [productId], references: [id])
  productId     Int
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId  Int
  qtyPerServing Float

  @@unique([productId, ingredientId])
  @@index([tenantId])
}

model IngredientLog {
  id           Int        @id @default(autoincrement())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId     String?
  outlet       Outlet?    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  change       Float // (+) restock/refund, (-) produksi/rusak
  cost         Float      @default(0)
  type         String // 'Produksi', 'Restock', 'Penyesuaian', 'Rusak', 'PO', 'Void', 'Distribusi'
  reason       String?
  description  String?
  referenceId  String?
  user         User?      @relation(fields: [userId], references: [id])
  userId       Int?
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, createdAt])
  @@index([tenantId, type])
  @@index([ingredientId])
}

model PurchaseOrder {
  id          Int      @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  poNumber    String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  supplierId  Int
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  status      String   @default("Draft") // Draft, Dikirim, Diterima, Diterima Sebagian, Dibatalkan
  notes       String?
  totalAmount Float    @default(0)

  items PurchaseOrderItem[]

  orderedAt  DateTime  @default(now())
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id           Int           @id @default(autoincrement())
  tenantId     String?
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poId         Int
  product      Product?      @relation(fields: [productId], references: [id])
  productId    Int?
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id])
  ingredientId Int?

  itemName    String
  unit        String
  qtyOrdered  Float
  qtyReceived Float  @default(0)
  unitPrice   Float
  subtotal    Float

  @@index([tenantId])
  @@index([poId])
  @@index([ingredientId])
  @@index([productId])
}

model Debt {
  id         Int           @id @default(autoincrement())
  tenantId   String?
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId Int
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId    Int?          @unique
  amount     Float
  remaining  Float
  status     String        @default("Belum Lunas")
  dueDate    DateTime?
  notes      String?
  payments   DebtPayment[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([tenantId])
}

model DebtPayment {
  id            Int      @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  debt          Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtId        Int
  amountPaid    Float
  paymentMethod String
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

// ─── Administrasi Staf, Cuti/Izin, Handover & SOP Dapur ─────────────────

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  type       String // 'Izin', 'Sakit', 'Cuti', 'Tukar Shift', 'Lainnya'
  startDate  String
  endDate    String
  reason     String
  photoUrl   String?
  status     String   @default("Pending")
  approvedBy String?
  adminNotes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model ShiftHandover {
  id              Int      @id @default(autoincrement())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId        String?
  outlet          Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  shiftName       String
  date            String
  cashBalance     Float    @default(0)
  equipmentStatus String?
  notes           String
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([outletId])
}

model KitchenChecklist {
  id        Int      @id @default(autoincrement())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId  String?
  outlet    Outlet?  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  type      String // 'OPENING' atau 'CLOSING'
  date      String
  shiftName String?
  itemsJson String
  notes     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([outletId])
}

// ─── Manajemen Gudang Pusat (Central Warehouse) & Multi-Satuan ─────────────

model WarehouseInbound {
  id            Int                    @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber String
  supplier      Supplier?              @relation(fields: [supplierId], references: [id])
  supplierId    Int?
  supplierName  String?
  user          User                   @relation(fields: [userId], references: [id])
  userId        Int
  totalAmount   Float
  paymentSource String                 @default("DANA_PRIBADI_OWNER")
  notes         String?
  date          DateTime               @default(now())
  isVoided      Boolean                @default(false)
  voidReason    String?
  voidedAt      DateTime?
  items         WarehouseInboundItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([supplierId])
  @@index([userId])
}

model WarehouseInboundItem {
  id              Int              @id @default(autoincrement())
  tenantId        String?
  inbound         WarehouseInbound @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  inboundId       Int
  ingredient      Ingredient       @relation(fields: [ingredientId], references: [id])
  ingredientId    Int
  itemName        String
  purchaseUnit    String
  purchaseQty     Float
  conversionRatio Float            @default(1)
  baseQty         Float
  purchasePrice   Float
  basePrice       Float
  subtotal        Float

  @@index([tenantId])
  @@index([inboundId])
  @@index([ingredientId])
}

model WarehouseRequisition {
  id                Int                        @id @default(autoincrement())
  tenantId          String?
  tenant            Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId          String?
  outlet            Outlet?                    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  reqNumber         String
  requestedBy       User                       @relation("ReqRequestedBy", fields: [requestedById], references: [id])
  requestedById     Int
  approvedBy        User?                      @relation("ReqApprovedBy", fields: [approvedById], references: [id])
  approvedById      Int?
  status            String                     @default("PENDING")
  totalTransferCost Float                      @default(0)
  notes             String?
  requestedAt       DateTime                   @default(now())
  approvedAt        DateTime?
  receivedAt        DateTime?
  isVoided          Boolean                    @default(false)
  voidReason        String?
  items             WarehouseRequisitionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, reqNumber])
  @@index([tenantId])
  @@index([outletId])
  @@index([tenantId, requestedAt])
  @@index([tenantId, status])
  @@index([requestedById])
}

model WarehouseRequisitionItem {
  id            Int                  @id @default(autoincrement())
  tenantId      String?
  requisition   WarehouseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  requisitionId Int
  ingredient    Ingredient           @relation(fields: [ingredientId], references: [id])
  ingredientId  Int
  itemName      String
  requestedUnit String
  requestedQty  Float
  baseQty       Float
  transferPrice Float
  subtotal      Float

  @@index([tenantId])
  @@index([requisitionId])
  @@index([ingredientId])
}

model OwnerFundTransaction {
  id            Int      @id @default(autoincrement())
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String // CAPITAL_IN, TRANSFER_TO_RESTO, REIMBURSEMENT_PAID
  amount        Float
  referenceType String?
  referenceId   String?
  description   String
  date          DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([userId])
}

model WarehouseSale {
  id              Int                 @id @default(autoincrement())
  tenantId        String?
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber   String
  customerName    String
  customerPhone   String?
  customerAddress String?
  saleDate        DateTime            @default(now())
  paymentMethod   String              @default("TRANSFER")
  paymentStatus   String              @default("PAID")
  totalAmount     Float
  totalHppCost    Float
  grossProfit     Float
  notes           String?
  isVoided        Boolean             @default(false)
  voidReason      String?
  voidedAt        DateTime?
  items           WarehouseSaleItem[]
  soldBy          User                @relation("WarehouseSaleSoldBy", fields: [soldById], references: [id])
  soldById        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, saleDate])
  @@index([soldById])
  @@index([paymentStatus])
}

model WarehouseSaleItem {
  id              Int           @id @default(autoincrement())
  tenantId        String?
  sale            WarehouseSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          Int
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  ingredientId    Int
  itemName        String
  saleUnit        String
  saleQty         Float
  conversionRatio Float         @default(1)
  baseQty         Float
  unitCostPrice   Float
  unitSalePrice   Float
  subtotalCost    Float
  subtotal        Float
  profit          Float

  @@index([tenantId])
  @@index([saleId])
  @@index([ingredientId])
}

model EmployeeLoan {
  id          Int       @id @default(autoincrement())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  amount      Float
  remaining   Float
  date        DateTime  @default(now())
  source      String    @default("KAS_OWNER")
  reason      String?
  status      String    @default("Belum Lunas")
  approvedBy  String?
  settledAt   DateTime?
  settledNote String?

  payments    EmployeeLoanPayment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, status])
  @@index([tenantId, date])
}

model EmployeeLoanPayment {
  id            Int          @id @default(autoincrement())
  tenantId      String?
  loan          EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId        Int
  amountPaid    Float
  paymentDate   DateTime     @default(now())
  paymentMethod String       @default("POTONG_GAJI")
  notes         String?
  paidBy        String?
  createdAt     DateTime     @default(now())

  @@index([tenantId])
  @@index([loanId])
}
