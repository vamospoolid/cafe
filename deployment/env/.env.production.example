# ==============================================================================
# Codenusa Multi-Tenant B2B SaaS POS - Production Environment Variables Template
# Copy this file to /var/www/codepos/backend/.env on your production VPS
# ==============================================================================

# Server Environment
PORT=5001
NODE_ENV=production
TZ=Asia/Jakarta

# PostgreSQL Database Connection (Production Pool)
# PENTING: connection_limit JANGAN lebih dari 20 per worker untuk menghindari
# PostgreSQL "too many clients" error. Default max_connections PostgreSQL = 100.
# Dengan PM2 instances=1: 1 worker x 20 pool = 20 connections. Aman.
DATABASE_URL="postgresql://poscafe_user:your_secure_db_password@localhost:5432/poscafe_db?schema=public&connection_limit=20&pool_timeout=30&connect_timeout=15"

# JWT Authentication Master Secret
# WAJIB minimum 64 karakter acak. Generate dengan: openssl rand -hex 64
# Sistem akan menolak boot produksi jika JWT_SECRET < 32 karakter!
JWT_SECRET="GANTI_DENGAN_64_KARAKTER_ACAK_openssl_rand_hex_64_PRODUCTION_ONLY"

# Encryption Keys (AES-256 for Tenant Midtrans BYOK & Database Backups)
PAYMENT_ENCRYPTION_KEY="your_production_aes256_payment_secret_key_32_chars"
BACKUP_ENCRYPTION_KEY="your_production_aes256_backup_master_key_32_chars"

# Level 1 Midtrans SaaS Billing Credentials (Platform Revenue)
MIDTRANS_SERVER_KEY="Mid-server-your-production-server-key"
MIDTRANS_CLIENT_KEY="Mid-client-your-production-client-key"
MIDTRANS_IS_PRODUCTION=true

# Dynamic Subdomain Base Domain
COOKIE_DOMAIN=".codenusa.id"
APP_DOMAIN="codenusa.id"

# CORS: Tambahkan domain/IP VPS atau domain staging yang diizinkan akses API.
# Pisahkan dengan koma tanpa spasi. Kosongkan jika hanya *.codenusa.id saja.
# Contoh: ALLOWED_ORIGINS=https://103.x.x.x,https://pos.kafe-custom.com
ALLOWED_ORIGINS=""

# ==============================================================================
# CATATAN OPERATIONAL VPS (WAJIB DIBACA SEBELUM DEPLOY)
# ==============================================================================
# 1. LOG ROTATION (WAJIB): Pasang pm2-logrotate agar log tidak memenuhi disk!
#    pm2 install pm2-logrotate
#    pm2 set pm2-logrotate:max_size 50M
#    pm2 set pm2-logrotate:retain 7
#
# 2. BACKUP RETENTION: Pastikan cron pembersihan backup aktif (setiap 30 menit
#    melalui setInterval di index.ts). Verifikasi di API:
#    GET /api/health/deep
#
# 3. DATABASE: Jalankan schema migration MANUAL sebelum deploy jika ada
#    perubahan skema yang memerlukan penghapusan kolom/tabel.
#    JANGAN pernah tambahkan --accept-data-loss ke skrip deploy!
#
# 4. PORT: Backend berjalan di PORT 5001 (konfigurasikan sama di ecosystem.config.js)
# ==============================================================================
